# ------------------------------------------------------------------------------
# FireFusion - Local Development Docker Environment Variables
# ------------------------------------------------------------------------------

# Application
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# PostgreSQL 17
POSTGRES_PORT=5432
POSTGRES_DB=fire-fusion
POSTGRES_USER=fire-fusion
POSTGRES_PASSWORD=fire-fusion-pass
DATABASE_URL=postgresql://fire-fusion:fire-fusion-pass@localhost:5432/fire-fusion

# MongoDB 8
MONGO_PORT=27017
MONGO_INITDB_DATABASE=fire-fusion
MONGO_INITDB_ROOT_USERNAME=fire-fusion
MONGO_INITDB_ROOT_PASSWORD=fire-fusion-pass
MONGODB_URI=mongodb://fire-fusion:fire-fusion-pass@localhost:27017/fire-fusion?authSource=admin

# Redis 8
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# DuckDB
DUCKDB_DATABASE=/data/fire_fusion.duckdb

# Optional Developer GUI Tools (docker compose --profile tools up)
DUCK_UI_PORT=5522
ADMINER_PORT=8080
REDIS_COMMANDER_PORT=8081
MONGO_EXPRESS_PORT=8082
